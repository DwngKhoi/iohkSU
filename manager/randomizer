#! /usr/bin/env bash

# Generate 3 random lowercase words (6 letters each)
word1=$(tr -dc 'a-z' </dev/urandom | head -c6)
word2=$(tr -dc 'a-z' </dev/urandom | head -c6)
word3=$(tr -dc 'a-z' </dev/urandom | head -c6)

export word1 word2 word3

# Replace package references before moving their package directories. Restrict sed to text
# files: applying it to the Gradle wrapper JAR corrupts the binary.
while IFS= read -r -d '' file; do
    sed -i \
        -e "s/com\.dwngkhoi\.iohksu/$word1.$word2.$word3/g" \
        -e "s/com\.dwngkhoi\.rootService/$word1.$word2.rootService/g" \
        -e "s/com\/dwngkhoi\/iohksu/$word1\/$word2\/$word3/g" \
        -e "s/com\/dwngkhoi\/rootService/$word1\/$word2\/rootService/g" \
        -e "s/com_dwngkhoi_iohksu/${word1}_${word2}_${word3}/g" "$file"
done < <(grep -IlZr . --exclude-dir=.gradle --exclude-dir=build --exclude-dir=.cxx .)

# Move source/AIDL package directory components only after their declarations/imports match.
find . -depth -type d -name 'iohksu' -execdir mv {} "$word3" \;
find . -depth -type d -name 'dwngkhoi' -execdir mv {} "$word2" \;
find . -depth -type d -name 'com' -execdir mv {} "$word1" \;

# Add -spoofed to fallback tag version and the explicit manager version.
sed -i -e '/fun getGitDescribe(): String {/,/^    }/ s/\.trim()$/.trim() + "-spoofed"/' build.gradle.kts
if [ -f version.txt ]; then
    printf '%s-spoofed\n' "$(cat version.txt)" > version.txt
fi
